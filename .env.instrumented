# `npm run build:instrumented` — the measurement build: a real optimised
# production build that still carries the measurement tooling.
#
# This is the one to use when taking a figure that must not be distorted by
# having DevTools attached (V8 drops WASM to a debuggable tier while an
# inspector is open: 2.75x slower on this build).
#
# Both flags, because measuring usually wants both halves: the harness compares
# engines against a buffer already in the webview, and the instruments measure
# the real PTY delivery path the harness cannot see.
#
# A plain `npm run build`, and therefore `npm run tauri build`, leaves both out.
VITE_WRUSTTY_INSTRUMENTS=1
VITE_WRUSTTY_BENCH=1
