<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves in a cloud backup or a transfer to a new phone. Command history is
     plain text, and its secret filter is only a heuristic. allowBackup="false" doesn't
     cover a device transfer on Android 12 and later, which is why this exists. Moving to
     a new phone goes through an encrypted export. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
