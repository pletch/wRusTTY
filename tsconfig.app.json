{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    // "node" is here for src/bench's test-support files (gridSnapshot.ts
    // reads the vendored .wasm off disk to instantiate it headlessly under
    // Vitest) — ambient types only, nothing in the shipped app imports Node
    // builtins.
    "types": ["vite/client", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    // This codebase was already written as if strict were on — `string | null`
    // unions, optional engine methods, `useRef<T | null>` — but nothing was
    // checking any of it. The discipline was there and the compiler wasn't.
    //
    // `noUncheckedIndexedAccess` and `exactOptionalPropertyTypes` are the
    // natural next two and are deliberately not enabled yet: turning them on
    // in the same pass would have buried the real nullability findings under
    // mechanical index assertions.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
