# Development defaults for `npm run dev` and `npm run tauri:dev` — everything a
# release build leaves out is on here, because this is the environment those
# tools are for. See the gates in src/main.tsx.

# The measurement instruments: `__wrusttyDelivery`, `__wrusttyPaneFlood`, and
# the Ctrl+Alt+D/F on-screen overlay.
VITE_WRUSTTY_INSTRUMENTS=1

# The benchmark harness, reached with `#bench` or Ctrl+Alt+B.
VITE_WRUSTTY_BENCH=1
